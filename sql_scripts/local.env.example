# 本地开发凭据（复制为 sql_scripts/local.env，填入真实值；local.env 不入 Git）
#
#   cp sql_scripts/local.env.example sql_scripts/local.env
#   vim sql_scripts/local.env
#   source sql_scripts/local.env
#
# DS Worker 不走此文件，由 CI 挂载 /opt/data_etl_secret/db.env，
# 任务里 source sql_scripts/load_env.sh 加载。

export MYSQL_HOST=192.168.19.21
export MYSQL_PORT=9030
export MYSQL_USER=root
export MYSQL_PASSWORD='your-password-here'

export STARROCKS_HOST="${MYSQL_HOST}"
export STARROCKS_PORT="${MYSQL_PORT}"
export STARROCKS_USER="${MYSQL_USER}"
export STARROCKS_PASSWORD="${MYSQL_PASSWORD}"
